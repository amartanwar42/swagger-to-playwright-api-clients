{
	"compilerOptions": {
		"target": "ES2022",
		"module": "nodenext",
		"lib": ["ES2022"],
		"types": ["node"],
		"outDir": "./dist",
		"rootDir": ".",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"moduleResolution": "nodenext"
	},
	"include": ["src/**/*", "generator-config.ts"],
	"exclude": ["node_modules", "dist", "src/tests", "src/clients/generatedClients"]
}
